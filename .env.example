# ShearPin environment — copy to .env and fill in
# NEAR testnet contract account (deployed wasm)
SHEARPIN_CONTRACT=v1.shearpin-owner-2.testnet
# NEAR account that owns the policy (owner = can freeze/reset/update)
SHEARPIN_SIGNER_ID=shearpin-owner-2.testnet
# ed25519 secret key of the owner account (ed25519:...)
SHEARPIN_OWNER_KEY=
# (optional) separate agent account; if unset, owner acts as signer
SHEARPIN_AGENT_ID=
SHEARPIN_AGENT_KEY=
# backend api the demo reports to
SHEARPIN_API=http://127.0.0.1:8787
# policy id used by the demo
SHEARPIN_POLICY=sat1
# NEAR RPC endpoint
SHEARPIN_RPC=https://rpc.testnet.fastnear.com
# (optional) Sepolia RPC for broadcasting signed EVM txs
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# (optional) Etherscan API key — enables the account-age, activity and
# prior-interactions signals in the counterparty check (sdk signals.ts).
# without it those signals degrade gracefully to "signal unavailable" notes.
# free key: https://etherscan.io/apis
ETHERSCAN_API_KEY=
# (optional) chain id for the Etherscan V2 multichain API (default 11155111 Sepolia)
ETHERSCAN_CHAIN_ID=11155111
# (optional) the paying agent's EOA — enables the prior-interactions signal
AGENT_EOA=
# backend port
PORT=8787