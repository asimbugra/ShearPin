# ShearPin environment — copy to .env and fill in
# NEAR testnet contract account (deployed wasm)
SHEARPIN_CONTRACT=v3.shearpin-owner-1.testnet
# NEAR account that owns the policy (owner = can freeze/reset/update)
SHEARPIN_SIGNER_ID=shearpin-owner-1.testnet
# ed25519 secret key of the owner account (ed25519:...)
SHEARPIN_OWNER_KEY=
# (optional) separate agent account; if unset, owner acts as signer
SHEARPIN_AGENT_ID=
SHEARPIN_AGENT_KEY=
# backend api the demo reports to
SHEARPIN_API=http://127.0.0.1:8787
# policy id used by the demo
SHEARPIN_POLICY=sat1
# NEAR RPC endpoint
SHEARPIN_RPC=https://rpc.testnet.fastnear.com
# (optional) Sepolia RPC for broadcasting signed EVM txs
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# backend port
PORT=8787